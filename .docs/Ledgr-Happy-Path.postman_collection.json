{
  "info": {
    "name": "Ledgr - Happy Path",
    "description": "End-to-end happy path for the Ledgr double-entry payment ledger.\n\nRun requests in order:\n1. Create accounts (or use seeded ones)\n2. Create a payment\n3. Authorize the payment\n4. Settle the payment\n5. Verify balances and ledger entries",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "sourceAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "destinationAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "holdAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Accounts",
      "item": [
        {
          "name": "1.1 Create Alice Wallet (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('sourceAccountId', jsonData.id);",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Account type is USER', function () {",
                  "    pm.expect(jsonData.type).to.eql('USER');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Alice Wallet\",\n    \"type\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        },
        {
          "name": "1.2 Create Bob Wallet (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('destinationAccountId', jsonData.id);",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Bob Wallet\",\n    \"type\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        },
        {
          "name": "1.3 Create Hold Account (SYSTEM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('holdAccountId', jsonData.id);",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Hold Account\",\n    \"type\": \"SYSTEM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        },
        {
          "name": "1.4 Get Alice Account",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{sourceAccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{sourceAccountId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Create Payment",
      "item": [
        {
          "name": "2.1 Create Payment ($50 Alice → Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('paymentId', jsonData.id);",
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Payment status is INITIATED', function () {",
                  "    pm.expect(jsonData.status).to.eql('INITIATED');",
                  "});",
                  "pm.test('Amount is 50', function () {",
                  "    pm.expect(Number(jsonData.amount)).to.eql(50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"{{sourceAccountId}}\",\n    \"destinationAccountId\": \"{{destinationAccountId}}\",\n    \"amount\": 50.00,\n    \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            }
          }
        },
        {
          "name": "2.2 Get Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Payment status is INITIATED', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('INITIATED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Authorize Payment",
      "item": [
        {
          "name": "3.1 Authorize Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Payment status is AUTHORIZED', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('AUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}/authorize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}", "authorize"]
            }
          }
        },
        {
          "name": "3.2 Check Alice Balance (should be -50)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Balance is -50 (debited)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Number(jsonData.balance)).to.eql(-50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{sourceAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{sourceAccountId}}", "balance"]
            }
          }
        },
        {
          "name": "3.3 Check Hold Balance (should be +50)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Hold balance is +50', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Number(jsonData.balance)).to.eql(50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{holdAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{holdAccountId}}", "balance"]
            }
          }
        },
        {
          "name": "3.4 Check Bob Balance (should be 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Bob balance is 0 (not yet settled)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Number(jsonData.balance)).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{destinationAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{destinationAccountId}}", "balance"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Settle Payment",
      "item": [
        {
          "name": "4.1 Settle Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Payment status is SETTLED', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('SETTLED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}/settle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}", "settle"]
            }
          }
        },
        {
          "name": "4.2 Check Alice Balance (should be -50)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Alice balance is -50', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Number(jsonData.balance)).to.eql(-50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{sourceAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{sourceAccountId}}", "balance"]
            }
          }
        },
        {
          "name": "4.3 Check Hold Balance (should be 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Hold balance is 0 (released)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Number(jsonData.balance)).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{holdAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{holdAccountId}}", "balance"]
            }
          }
        },
        {
          "name": "4.4 Check Bob Balance (should be +50)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bob balance is +50 (received)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Number(jsonData.balance)).to.eql(50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{destinationAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{destinationAccountId}}", "balance"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Verify Ledger",
      "item": [
        {
          "name": "5.1 Alice Ledger Entries",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Alice has 1 ledger entry (DEBIT)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.eql(1);",
                  "    pm.expect(jsonData[0].entryType).to.eql('DEBIT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{sourceAccountId}}/ledger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{sourceAccountId}}", "ledger"]
            }
          }
        },
        {
          "name": "5.2 Bob Ledger Entries",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bob has 1 ledger entry (CREDIT)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.eql(1);",
                  "    pm.expect(jsonData[0].entryType).to.eql('CREDIT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{destinationAccountId}}/ledger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{destinationAccountId}}", "ledger"]
            }
          }
        },
        {
          "name": "5.3 Hold Account Ledger Entries",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Hold has 2 entries (CREDIT + DEBIT = net zero)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{holdAccountId}}/ledger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{holdAccountId}}", "ledger"]
            }
          }
        },
        {
          "name": "5.4 Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('App is healthy', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Idempotency Test",
      "item": [
        {
          "name": "6.1 Create Payment with fixed key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.environment.set('idempotentPaymentId', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "test-idempotency-key-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"{{sourceAccountId}}\",\n    \"destinationAccountId\": \"{{destinationAccountId}}\",\n    \"amount\": 25.00,\n    \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            }
          }
        },
        {
          "name": "6.2 Retry with same key (should return same payment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 (cached response)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Same payment ID returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get('idempotentPaymentId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "test-idempotency-key-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountId\": \"{{sourceAccountId}}\",\n    \"destinationAccountId\": \"{{destinationAccountId}}\",\n    \"amount\": 25.00,\n    \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            }
          }
        }
      ]
    }
  ]
}